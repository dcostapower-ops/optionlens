# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Stocky (from the Managed Agents integration panel)
STOCKY_AGENT_ID=agent_01Vs8LnyLYVarn95Uhjm4saV
STOCKY_ENVIRONMENT_ID=env_01DjvqsavJUkxFrZeHNnMHMU

# Massive (formerly Polygon.io) stocks developer subscription key.
# Used two ways:
#   - `npm run connect-massive` stores it in an Anthropic vault so Stocky can call
#     Massive live. The key never enters Stocky's sandbox.
#   - Stockypower also uses it to pull a daily-bar snapshot for each symbol and
#     mounts that file in Stocky's session as a backup.
MASSIVE_API_KEY=

# Written by `npm run connect-massive`. Leave blank until you've run it.
STOCKY_VAULT_ID=

# Optional
# MASSIVE_BASE_URL=https://api.massive.com
# STOCKY_HISTORY_YEARS=2
PORT=8790
